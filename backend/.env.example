PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/car_dealership
# Generate a unique random value of at least 32 characters before starting.
JWT_SECRET=
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173
INITIAL_ADMIN_NAME=Admin User
# Set explicit credentials before running seed:admin. No default password exists.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
